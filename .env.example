# Same-origin mock API. Set a full origin when the real backend is connected.
NEXT_PUBLIC_API_BASE_URL=

# Leave empty to use the development mock realtime transport.
# Set a ws:// or wss:// URL to connect to the backend WebSocket.
NEXT_PUBLIC_WS_URL=

# mock: development fixtures. live: hide development credential hints.
NEXT_PUBLIC_DATA_SOURCE=mock

# Required. At least 32 characters. Never commit a real secret.
SESSION_SECRET=replace-with-a-random-string-at-least-32-chars
